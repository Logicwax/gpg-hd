except ImportError:
  HAVE_CARD_LIBS = False
import shutil
import tempfile
import argparse

# Scratch GNUPGHOME (set up by init_work_dir): a private temp directory, so it does not matter whether the
# directory gpg-hd is run from is writable.
TEMP = None
gpg_cmdline = None


def init_work_dir():
  global TEMP, gpg_cmdline
  TEMP = tempfile.mkdtemp(prefix="gpg-hd-", dir="/dev/shm" if os.path.isdir("/dev/shm") else None)
  os.chmod(TEMP, 0o700)
  os.environ['GNUPGHOME'] = TEMP
  gpg_cmdline = "gpg --homedir " + TEMP + " --keyring trustedkeys.gpg --no-default-keyring --expert "


def reset_work_dir():
  # GPG is lame and doesn't like when we remove old keyIDs that are now attached to subkeys,
  # so start over with a fresh keydb
  subprocess.run(["gpgconf", "--homedir", TEMP, "--kill", "all"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
  shutil.rmtree(TEMP, ignore_errors=True)
  os.makedirs(TEMP, mode=0o700)


def remove_work_dir():
  subprocess.run(["gpgconf", "--homedir", TEMP, "--kill", "all"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
  shutil.rmtree(TEMP, ignore_errors=True)


def output_dir():
  """keys/ in the directory gpg-hd was run from, or in the home directory if that one is not writable."""
  for base in (os.getcwd(), os.path.expanduser("~")):
    path = os.path.join(base, "keys")
    try:
      os.makedirs(path, exist_ok=True)
      tempfile.TemporaryFile(dir=path).close()
      return path
    except OSError:
      continue
  raise SystemExit("Cannot write a keys directory in the current directory or the home directory.")

def GPG_get_masterkey():
  id = subprocess.Popen(gpg_cmdline + "--list-keys | " \
    "tail -n +3 | awk \'{ print $1 }\' | grep -v \"pub\" | grep -v \"uid\" | tr -s \'\\n\' \'\\n\'", \
    stdout=subprocess.PIPE, \
    stdin=subprocess.PIPE, \
    shell=True \
    )
  return id.communicate()[0].decode('utf-8').strip()


def GPG_get_keygrips():
  # Get keygrips
  kg = subprocess.Popen(gpg_cmdline + \
    "--with-keygrip -K | grep \"Keygrip\" | awk \'{ print $3 }\'", \
    stdout=subprocess.PIPE, \
    stdin=subprocess.PIPE, \
    shell=True \
    )
  return kg.communicate()[0].decode('utf-8')


def gpg_edit_key(key_id, answers, timestamp=None):
  """Run `gpg --edit-key`, answering each prompt by the tag gpg announces on --status-fd.

  `answers` maps a tag to the lines to send for successive prompts of that tag. A prompt without an answer
  left aborts, so an unexpected gpg menu is never answered by accident (the menu texts and the number of
  PIN/confirmation prompts differ between gpg versions, which is why blind scripted answers break).
  """
  pending = {tag: list(lines) for tag, lines in answers.items()}
  status_r, status_w = os.pipe()
  cmd = ["gpg", "--homedir", TEMP, "--keyring", "trustedkeys.gpg", "--no-default-keyring", "--expert",
         "--pinentry-mode=loopback", "--no-tty"]
  if timestamp:
    # The trailing "!" freezes gpg's clock. Without it the faked time keeps ticking from `timestamp`, so a slow
    # moment (agent start, a busy machine) between gpg starting and the subkey being made gives it a creation
    # time of timestamp+1 or more, which changes its fingerprint: the same seed would not give the same keychain.
    cmd.append("--faked-system-time=" + timestamp + "!")
  cmd += ["--command-fd=0", "--status-fd=" + str(status_w), "--edit-key", key_id]
  gpg = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
    pass_fds=(status_w,))
  os.close(status_w)
  try:
    with os.fdopen(status_r) as status:
      for line in status:
        fields = line.split()
        if len(fields) >= 3 and fields[1] in ("GET_LINE", "GET_BOOL", "GET_HIDDEN"):
          tag = fields[2]
          if not pending.get(tag):
            gpg.kill()
            raise RuntimeError("unexpected gpg prompt '" + tag + "' while editing key " + key_id)
          gpg.stdin.write((pending[tag].pop(0) + "\n").encode())
          gpg.stdin.flush()
  finally:
    gpg.stdin.close()
    error = gpg.stderr.read().decode(errors="replace")
    returncode = gpg.wait()
  if returncode != 0:
    raise RuntimeError("gpg --edit-key " + key_id + " failed: " + error)


def GPG_set_primary_key(keyID):
  # Set masterkey as primary
  gpg_edit_key(keyID, {"keyedit.prompt": ["uid 1", "primary", "save"]})


def GPG_add_existing_subkey(parent_keyID, subkey_grip, timestamp, toggles):
  # addkey -> (13) Existing key -> keygrip -> toggle capabilities off/on -> never expires
  gpg_edit_key(parent_keyID, {
    "keyedit.prompt": ["addkey", "save"], "keygen.algo": ["13"], "keygen.keygrip": [subkey_grip],
    "keygen.flags": toggles + ["Q"], "keygen.valid": ["0"]}, timestamp)


def GPG_add_auth_subkey(parent_keyID, subkey_grip, timestamp):
  # Auth subkey: sign and encrypt off, authenticate on
  GPG_add_existing_subkey(parent_keyID, subkey_grip, timestamp, ["S", "E", "A"])


def GPG_add_enc_subkey(parent_keyID, subkey_grip, timestamp):
  # Enc subkey: sign off
  GPG_add_existing_subkey(parent_keyID, subkey_grip, timestamp, ["S"])


def GPG_add_sig_subkey(parent_keyID, subkey_grip, timestamp):
  # Sig subkey: encrypt off
  GPG_add_existing_subkey(parent_keyID, subkey_grip, timestamp, ["E"])


def GPG_import_keychain(keychain_filename):
    gpg_import = subprocess.Popen(gpg_cmdline + "--import " + keychain_filename, stdout=subprocess.PIPE, shell=True)
    print(gpg_import.communicate())


def GPG_create_key(user_id, seed, timestamp):
  # Create deterministic raw GPG key
  rand = DRBG(hashlib.sha256(seed).digest())
  rsa_key = rsa_derive.generate(4096, rand.generate)

  # Since we're auto-generating the key, default the creation time to UNIX time of (timeStamp)
  gpg_key = rsa_key.openpgp_secret_key(user_id, int(timestamp))

  # Import openPGP-formatted RSA key into GPG keychain
  gpg_import = subprocess.Popen(gpg_cmdline + "--import", stdin=subprocess.PIPE, shell=True)
  gpg_import.communicate(gpg_key)
  return rsa_key


# ---------------------------------------------------------------------------
# Smartcard, driven directly through the card's OpenPGP applet (yubikit); only needed for --card
# ---------------------------------------------------------------------------

DEFAULT_ADMIN_PIN = "12345678"
SLOT = {"sig": KEY_REF.SIG, "enc": KEY_REF.DEC, "aut": KEY_REF.AUT} if HAVE_CARD_LIBS else {}
SLOT_NAME = {KEY_REF.SIG: "signature", KEY_REF.DEC: "encryption", KEY_REF.AUT: "authentication"} if HAVE_CARD_LIBS else {}


def say(message):
  """Progress line for the operator, shown immediately."""
  print(message, flush=True)


def kill_daemons():
  """Stop any gpg-agent, scdaemon or ssh-agent a previous script left behind.

  A stale scdaemon holds the card exclusively and a hung agent blocks every later gpg call, so this runs
  before each card access and at the start and end of the scripts.
  """
  subprocess.run(["killall", "gpg-agent", "scdaemon", "ssh-agent"],
    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _single_device():
  """The one attached YubiKey, asking again until exactly one is present.

  Several keys are refused so a factory reset can never hit the wrong one; none (or several) just means the
  user has to insert (or remove) a card and press enter, as many times as it takes.
  """
  while True:
    devices = list_all_devices()
    if len(devices) == 1:
      return devices[0][0]
    if devices:
      input("Found %d YubiKeys, expected exactly one. Please remove the others, then press enter " \
        % len(devices))
    else:
      input("No YubiKey found. Please insert a Yubikey/smartcard, then press enter ")


def _smartcard_device():
  """The one attached YubiKey, once its smartcard interface is visible through pcscd.

  If a gpg scdaemon grabs a card the moment it is inserted, pcscd fails to claim it (LIBUSB_ERROR_BUSY)
  and keeps no reader for it until it is restarted; the key then only shows up on its HID side and
  yubikit reports "Unsupported Connection type".  A fresh pcscd rescans the bus, so restart it (as the
  old scripts did with `sudo killall pcscd`) and look again.
  """
  kill_daemons()
  for attempt in range(3):
    device = _single_device()
    if device.supports_connection(SmartCardConnection):
      return device
    if attempt == 0:
      subprocess.run(["sudo", "killall", "pcscd"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
      input("Please run 'sudo systemctl restart pcscd' in another terminal, then press enter ")
    time.sleep(2)
    kill_daemons()
  raise SystemExit("The YubiKey's smartcard interface is still not available through pcscd.")


@contextmanager
def card():
  """Open the OpenPGP applet of the one and only attached YubiKey."""
  with _smartcard_device().open_connection(SmartCardConnection) as connection:
    yield OpenPgpSession(connection)


def card_factory_reset(session):
  say("Resetting card to factory settings ...")
  session.reset()


def card_write_key(session, slot, key, creation_time, fingerprint):
  """Import `key` into `slot` and record the metadata gpg needs to match card and certificate."""
  say("Writing %s key to card ..." % SLOT_NAME[slot])
  session.put_key(slot, key)
  session.set_generation_time(slot, creation_time)
  session.set_fingerprint(slot, fingerprint)


def _public_bytes(public_key):
  if isinstance(public_key, rsa.RSAPublicKey):
    n = public_key.public_numbers()
    return b"rsa" + n.n.to_bytes(512, "big") + n.e.to_bytes(4, "big")
  if isinstance(public_key, ed25519.Ed25519PublicKey):
    return public_key.public_bytes_raw()
  return public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)


def card_verify(session, slots):
  """Read the card back: for each {slot: parsed key} the fingerprint, generation time and public key must match."""
  say("Verifying card contents ...")
  fingerprints = session.get_fingerprints()
  times = session.get_generation_times()
  for slot, key in slots.items():
    if fingerprints[slot] != bytes.fromhex(key["fpr"]):
      raise SystemExit("Card verification failed: %s fingerprint mismatch" % slot.name)
    if times[slot] != key["created"]:
      raise SystemExit("Card verification failed: %s generation time mismatch" % slot.name)
    if _public_bytes(session.get_public_key(slot)) != _public_bytes(key["key"].public_key()):
      raise SystemExit("Card verification failed: %s public key mismatch" % slot.name)


def card_private_key(rsa_key):
  """The derived key as a cryptography RSA private key, which is what yubikit imports."""
  return rsa.RSAPrivateNumbers(rsa_key.p, rsa_key.q, rsa_key.d,
    rsa.rsa_crt_dmp1(rsa_key.d, rsa_key.p), rsa.rsa_crt_dmq1(rsa_key.d, rsa_key.q),
    rsa.rsa_crt_iqmp(rsa_key.p, rsa_key.q), rsa.RSAPublicNumbers(rsa_key.e, rsa_key.n)).private_key()


def GPG_card_write(keys, timestamp, what):
  """Factory reset the inserted card and write `keys` ({"aut"|"enc"|"sig": key}) to it, then read it back."""
  if not HAVE_CARD_LIBS:
    raise SystemExit("--card and --card-master need python3-ykman and python3-cryptography.")
  created = int(timestamp)
  slots = {SLOT[role]: {"key": card_private_key(key), "created": created,
                        "fpr": key.fingerprint(created).hex().upper()} for role, key in keys.items()}
  print("\nPlease insert the Yubikey/smartcard for the " + what + ".")
  input("WARNING: This will reset yubikey and provision it with new GPG keys.  Press any-key to continue (or CTRL+C to abort)")
  with card() as session:
    card_factory_reset(session)
    session.verify_admin(DEFAULT_ADMIN_PIN)
    for slot, key in slots.items():
      card_write_key(session, slot, key["key"], key["created"], bytes.fromhex(key["fpr"]))
    card_verify(session, slots)


def GPG_export_keychain(keyID, timestamp, private_filename, public_filename, ssh_filename):
  # Export full private keychain to file
  gpg_export = subprocess.Popen(gpg_cmdline + "--armor --export-secret-keys " + keyID, \
    stdout=subprocess.PIPE, shell=True)
  privateKeyChain = gpg_export.communicate()[0].decode('utf-8')
  keyChainfile = open(private_filename, "w")
  keyChainfile.write(privateKeyChain)
  keyChainfile.close()

  # Export full public keychain to file
  export = subprocess.Popen(gpg_cmdline + "--armor --export " + keyID, stdout=subprocess.PIPE, shell=True)
  publicKeyChain = export.communicate()[0].decode('utf-8')
  keyChainfile = open(public_filename, "w")
  keyChainfile.write(publicKeyChain)
  keyChainfile.close()

  # Export SSH public key to file
  # Fake time necessary if key is already expired
  export = subprocess.Popen(gpg_cmdline + "--faked-system-time=" + timestamp +  \
    " --export-ssh-key " + keyID, stdout=subprocess.PIPE, shell=True)
  ssh_key = export.communicate()[0].decode('utf-8')
  sshfile = open(ssh_filename, "w")
  sshfile.write(ssh_key)
  sshfile.close()


if __name__ == '__main__':
  os.system("killall gpg-agent scdaemon ssh-agent > /dev/null 2>&1")
  init_work_dir()
  keys_path = output_dir()
  outputs = [os.path.join(keys_path, f) for f in ("private_keychain.asc", "public_keychain.asc", "ssh_key.asc")]
  existing = [f for f in outputs if os.path.exists(f)]
  if existing:
    raise SystemExit("These files already exist, move them away first:\n  " + "\n  ".join(existing))
  print("\n")
  parser = argparse.ArgumentParser()
  parser.add_argument("seed_phrase", type=str, help="Seed value or BIP39 phrase")
  parser.add_argument("-n", "--name", help="Full Name")
  parser.add_argument("-e", "--email", help="Email")
  parser.add_argument("-d", "--date", help="Key creation timestamp (in unix epoch time)")
  parser.add_argument("-c", "--card", help="Write subkeys to Yubikey", action="store_true")
  parser.add_argument("-m", "--card-master", help="Write master key to a (separate) Yubikey", action="store_true")
  args = parser.parse_args()

  if (args.name):
    name = args.name
  else:
    name = input('Name: ')
  if (args.email):
    email = args.email
  else:
    email = input('Email: ')
  if (args.date):
    if(args.date == "0"):
      print("Timestamp of 0 is not valid, please choose at least 1")
    timestamp = args.date
  else:
    # GPG / yubikeys won't allow adding subkeys keytocard with timestamp of unix epoch 0
    # We will use timestamp of 1 (A second into 1970-01-01) to indicate this is GPG-HD generated keys
    timestamp = "1";
  card_write = False
  if (args.card):
    card_write = True
  else:
    # Assume if they forget name or email, they probably should be asked about writing to cards
    if (not args.card_master and (not args.email or not args.name)):
      if(input('Write keys to card? [y/n]: ') == 'y'):
        card_write = True
  if (args.seed_phrase):
    seed = args.seed_phrase
  else:
    seed = input('Seed: ')
  user_id = '%s <%s>' % (name, email)

  # CA masterkey is sha256 of input seed, and the three subkeys are recursive sha256 hashes of that
  masterkey_hash = hashlib.sha256(seed.encode()).hexdigest().encode()
  authkey_hash = hashlib.sha256(masterkey_hash).hexdigest().encode()
  enckey_hash = hashlib.sha256(authkey_hash).hexdigest().encode()
  sigkey_hash = hashlib.sha256(enckey_hash).hexdigest().encode()

  # Create master CA key
  master_key = GPG_create_key(user_id, masterkey_hash, timestamp)
  masterkeyID = GPG_get_masterkey()

  # Create 3 subkeys
  auth_key = GPG_create_key(user_id, authkey_hash, timestamp)
  enc_key = GPG_create_key(user_id, enckey_hash, timestamp)
  sig_key = GPG_create_key(user_id, sigkey_hash, timestamp)

  # GPG needs grips for moving to subkeys
  keygrips = GPG_get_keygrips()

  # Assemble the keychain
  GPG_set_primary_key(masterkeyID)
  GPG_add_auth_subkey(masterkeyID, keygrips.split('\n')[1], timestamp)
  GPG_add_enc_subkey(masterkeyID, keygrips.split('\n')[2], timestamp)
  GPG_add_sig_subkey(masterkeyID, keygrips.split('\n')[3], timestamp)

  GPG_export_keychain(masterkeyID, timestamp, \
    os.path.join(keys_path, "private_keychain.asc"), \
    os.path.join(keys_path, "public_keychain.asc"), \
    os.path.join(keys_path, "ssh_key.asc") \
    )

  reset_work_dir()

  GPG_import_keychain(os.path.join(keys_path, "private_keychain.asc"))

  # just for show...
  print("\n\n\n")
  gpg_list = subprocess.Popen(gpg_cmdline + "--list-keys", shell=True)
  gpg_list.communicate()
  print("\n")
  print(os.path.join(keys_path, "private_keychain.asc") + " Created\n")
  print(os.path.join(keys_path, "public_keychain.asc") + " Created\n")
  print(os.path.join(keys_path, "ssh_key.asc") + " Created\n")

  # The master key goes on a card of its own (signature slot, like the CA card of gpg-provision); the subkeys
  # on another. Each card is reset first, so insert them one at a time.
  if(args.card_master):
    GPG_card_write({"sig": master_key}, timestamp, "master key")
  if(card_write):
    GPG_card_write({"aut": auth_key, "enc": enc_key, "sig": sig_key}, timestamp, "three subkeys")

  remove_work_dir()

